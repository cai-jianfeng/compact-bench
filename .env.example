# Copy to .env and fill in your model gateway settings.
CB_API_KEY=
CB_AGENT_MODEL=kimi-k3
CB_MESSAGES_URL=https://YOUR_GATEWAY/v1/messages
CB_RESPONSES_URL=https://YOUR_GATEWAY/v1/responses
CB_CHAT_URL=https://YOUR_GATEWAY/v1/chat/completions
CB_SUMMARIZER_API=auto

# Public HF data is downloaded automatically. For restricted data, set HF_TOKEN.
CB_HF_DATASET=caijanfeng/compact-bench
CB_DATA_REVISION=main
# HF_TOKEN=
